# Sustune Care — Environment Configuration Example

# Canonical Domain URL
NEXT_PUBLIC_APP_URL=https://www.sustunecare.com

# Form Delivery & Enquiry Notification Destination
CONTACT_RECEIVER_EMAIL=contact@sustunecare.com

# External Email Provider Credentials (Optional — local logging is active if unset)
# RESEND_API_KEY=re_your_api_key_here
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@sustunecare.com
# SMTP_PASS=your_secret_password

# External Video CDN Base URL (Optional — defaults to /videos/ if empty)
NEXT_PUBLIC_VIDEO_CDN_URL=
